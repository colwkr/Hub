{
  "about": "Every widget a layout row can place, by screen. Kept in step with the widgets() maps in finance.js, car.js, health.js and HOME_W in index.html. Custom widget types (ids starting x.) are listed in manifest.json and can go on any screen. Each screen's default is the order it draws today, the starting point for a new layout row.",
  "devices": {
    "names": "ipad, phone, pc (automatic), or a name set with ?device= - matched first",
    "types": "phone, tablet, desktop - matched next",
    "any": "* - every device without a more specific row"
  },
  "sizes": {
    "s": "a third of the width",
    "m": "half (default)",
    "l": "two thirds",
    "full": "the whole width"
  },
  "everywhere": {
    "jarvis.live": {
      "label": "Jarvis: his state, your words as he hears them, his reply as it streams (size s: just the state)"
    }
  },
  "screens": {
    "home": {
      "note": "Cards beside the orb, plus the app icons (the apps list). Home size 's' shows just the main line.",
      "widgets": {
        "home.meetings": {
          "label": "Meetings today"
        },
        "home.calendar": {
          "label": "Calendar events today"
        },
        "home.tasks": {
          "label": "Tasks due today"
        },
        "home.bills": {
          "label": "Bills due today or late",
          "filters": {
            "late_only": "true: only late ones"
          }
        },
        "home.birthdays": {
          "label": "Birthdays today"
        },
        "home.packages": {
          "label": "Packages out for delivery or delivered"
        },
        "home.reminders": {
          "label": "Reminders due"
        },
        "home.car": {
          "label": "Car needs a look"
        },
        "home.pets": {
          "label": "Pet checkups due"
        },
        "home.assistant": {
          "label": "Assistant key expiring"
        }
      },
      "common_filters": {
        "max": "show at most this many cards of this kind"
      },
      "apps": [
        "tasks",
        "calendar",
        "notes",
        "reminders",
        "finance",
        "health",
        "car",
        "places",
        "packages",
        "pets",
        "lights",
        "tv",
        "settings"
      ],
      "default": [
        "home.assistant",
        "home.meetings",
        "home.calendar",
        "home.tasks",
        "home.bills",
        "home.birthdays",
        "home.packages",
        "home.reminders",
        "home.car",
        "home.pets"
      ]
    },
