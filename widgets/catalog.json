{
  "about": "Every widget a layout row can place, by screen. Kept in step with the widgets() maps in finance.js, car.js, health.js and HOME_W in index.html. Custom widget types (ids starting x.) are listed in manifest.json and can go on any screen.",
  "devices": ["phone", "tablet", "desktop", "*"],
  "sizes": { "s": "a third of the width", "m": "half (default)", "l": "two thirds", "full": "the whole width" },
  "screens": {
    "home": {
      "note": "Cards beside the orb, plus the app icons (the apps list). Home size 's' shows just the main line.",
      "widgets": {
        "home.meetings": { "label": "Meetings today" },
        "home.calendar": { "label": "Calendar events today" },
        "home.tasks": { "label": "Tasks due today" },
        "home.bills": { "label": "Bills due today or late", "filters": { "late_only": "true: only late ones" } },
        "home.birthdays": { "label": "Birthdays today" },
        "home.packages": { "label": "Packages out for delivery or delivered" },
        "home.reminders": { "label": "Reminders due" },
        "home.car": { "label": "Car needs a look" },
        "home.pets": { "label": "Pet checkups due" },
        "home.assistant": { "label": "Assistant key expiring" }
      },
      "common_filters": { "max": "show at most this many cards of this kind" },
      "apps": ["tasks", "calendar", "notes", "reminders", "finance", "health", "car", "places", "packages", "pets", "lights", "tv", "settings"]
    },
    "finance": {
      "note": "The Finance Overview section.",
      "widgets": {
        "fin.approve": { "label": "Charges needing approval" },
        "fin.pay-notes": { "label": "Pay notes" },
        "fin.worth": { "label": "Net worth" },
        "fin.money": { "label": "Where the month's money went" },
        "fin.pay": { "label": "This month's pay" },
        "fin.accounts": { "label": "Account balances" },
        "fin.saving": { "label": "Savings" },
        "fin.heat": { "label": "Spending calendar" },
        "fin.day": { "label": "A day's spending" },
        "fin.bill-line": { "label": "Bills timeline for the month" },
        "fin.bills": { "label": "Bills list", "filters": { "status": "upcoming | late | unpaid | paid | all", "group": "bill | sub", "days": "only due within this many days" } }
      }
    },
    "health": {
      "widgets": {
        "health.log": { "label": "Quick log bar (bed, wake, gym, run)" },
        "health.sleep": { "label": "Sleep, last 14 nights" },
        "health.gym": { "label": "Gym, 12 weeks" },
        "health.run": { "label": "Running, 8 weeks" },
        "health.habits": { "label": "Habits, 7 days" }
      }
    },
    "car": {
      "widgets": {
        "car.hero": { "label": "The car and its mileage" },
        "car.oil": { "label": "Next oil change" },
        "car.money": { "label": "Car money" },
        "car.issues": { "label": "Open issues" },
        "car.recs": { "label": "Shop recommendations" },
        "car.history": { "label": "Service history" },
        "car.notes": { "label": "Notes" },
        "car.details": { "label": "Specs and details" }
      }
    }
  }
}
